{
  "name": "@mockmarlin/saas-server",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "description": "Fastify plugin for SaaS session, billing, notifications, uploads, and operations",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./billing/dodo": {
      "types": "./dist/adapters/dodo.d.ts",
      "default": "./dist/adapters/dodo.js"
    },
    "./billing/stripe": {
      "types": "./dist/adapters/stripe.d.ts",
      "default": "./dist/adapters/stripe.js"
    },
    "./billing/paddle": {
      "types": "./dist/adapters/paddle.d.ts",
      "default": "./dist/adapters/paddle.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@mockmarlin/saas-contract": "file:../saas-contract",
    "fastify": "^5.6.1",
    "fastify-plugin": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2",
    "vitest": "^5.0.2"
  }
}
